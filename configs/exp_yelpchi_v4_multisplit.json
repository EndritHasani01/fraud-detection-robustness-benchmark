{
  "experiment_name": "gfd_robustness_benchmark_v4_multisplit",
  "created_date": "2026-07-12",
  "project_topic": "Fraud detection using graphs (node-level anomaly/fraud classification)",
  "research_purpose": "Confirm whether the v3/r5 conclusions survive independent stratified data splits while using a density-relative relation-camouflage budget.",
  "datasets": [
    {
      "dataset_id": "yelpchi",
      "source": "dgl.data.FraudDataset",
      "source_name": "yelp",
      "notes": "YelpChi as exposed by DGL FraudDataset."
    }
  ],
  "data_splits": [
    {
      "split_id": "s0",
      "train_size": 0.4,
      "val_size": 0.2,
      "split_seed": 717,
      "policy": "First preregistered stratified 40/20/40 split."
    },
    {
      "split_id": "s1",
      "train_size": 0.4,
      "val_size": 0.2,
      "split_seed": 1729,
      "policy": "Second preregistered stratified 40/20/40 split."
    },
    {
      "split_id": "s2",
      "train_size": 0.4,
      "val_size": 0.2,
      "split_seed": 3253,
      "policy": "Third preregistered stratified 40/20/40 split."
    }
  ],
  "graph_representation": {
    "canonical_view": "homogeneous",
    "from_source_view": "heterograph",
    "conversion": "dgl.to_homogeneous",
    "rationale": "Keep the shared v3 evaluation view so split-stability results remain comparable with r5."
  },
  "models": [
    {
      "model_id": "mlp",
      "category": "baseline",
      "type": "mlp",
      "input": "node_features_only"
    },
    {
      "model_id": "sage",
      "category": "baseline",
      "type": "graphsage",
      "input": "graph_plus_node_features"
    },
    {
      "model_id": "pmp",
      "category": "specialized",
      "type": "pmp",
      "repo_path": "Repos/PMP-master",
      "hparams": {
        "full_neighbors": false,
        "sampled_neighbors": [10],
        "batch_size": 512,
        "num_workers": 0,
        "epochs": 100,
        "patience": 10
      },
      "notes": "Feasibility adapter; this is not the paper's full relation-aware configuration."
    },
    {
      "model_id": "secgfd",
      "category": "specialized",
      "type": "sec_gfd",
      "repo_path": "Repos/SEC-GFD-main",
      "hparams": {
        "hid_dim": 32,
        "order_d": 2,
        "high_order": 1,
        "lemda": 0.2,
        "lr": 0.01,
        "weight_decay": 0.0
      },
      "notes": "Reduced-cost benchmark configuration retained for comparability with r5."
    }
  ],
  "scenarios": [
    {
      "scenario_id": "heterophily_rewire_oracle",
      "family": "heterophily",
      "scenario_group": "heterophily",
      "severity_param": "p_rewire",
      "severity_values": [0.0, 0.15, 0.3],
      "method": "rewire_edge_dst_to_opposite_label",
      "oracle_mode": "oracle",
      "oracle_labels": true,
      "graph_view_mode": "heterograph_aware_generation",
      "relation_filter": ["net_rsr", "net_rtr", "net_rur"],
      "allow_self_loops": false,
      "reject_existing": true,
      "reject_duplicates": true,
      "max_attempt_multiplier": 20
    },
    {
      "scenario_id": "heterophily_rewire_nonoracle",
      "family": "heterophily",
      "scenario_group": "heterophily",
      "severity_param": "p_rewire",
      "severity_values": [0.0, 0.15, 0.3],
      "method": "rewire_edge_dst_to_feature_pseudo_opposite_label",
      "oracle_mode": "non_oracle",
      "oracle_labels": false,
      "graph_view_mode": "heterograph_aware_generation",
      "relation_filter": ["net_rsr", "net_rtr", "net_rur"],
      "fixed_feature_partition_across_severity": true,
      "allow_self_loops": false,
      "reject_existing": true,
      "reject_duplicates": true,
      "max_attempt_multiplier": 20
    },
    {
      "scenario_id": "camouflage_feature_oracle",
      "family": "camouflage_feature",
      "scenario_group": "camouflage",
      "severity_param": "p_cam_feat",
      "severity_values": [0.0, 0.15, 0.3],
      "method": "replace_fraud_features_with_normal_features",
      "oracle_mode": "oracle",
      "oracle_labels": true,
      "graph_view_mode": "canonical",
      "gamma": 1.0
    },
    {
      "scenario_id": "camouflage_relation_oracle",
      "family": "camouflage_relation",
      "scenario_group": "camouflage",
      "severity_param": "p_cam_rel",
      "severity_values": [0.0, 0.15, 0.3],
      "method": "add_relation_camouflage_edges",
      "oracle_mode": "oracle",
      "oracle_labels": true,
      "graph_view_mode": "heterograph_aware_generation",
      "relation_filter": ["net_rsr", "net_rtr", "net_rur"],
      "camouflage_edge_degree_ratio": 0.25,
      "camouflage_min_edges_per_node": 4,
      "camouflage_max_edges_per_node": 64,
      "remove_suspicious_ratio": 0.5,
      "allow_self_loops": false,
      "reject_existing": true,
      "reject_duplicates": true,
      "max_attempt_multiplier": 20,
      "notes": "Allocate benign-looking edges as a bounded fraction of each selected fraud node's observed out-degree, avoiding the underpowered fixed +2-edge stress seen in r5."
    },
    {
      "scenario_id": "noise_edges_uniform",
      "family": "noise",
      "scenario_group": "noise",
      "severity_param": "edge_noise_rate",
      "severity_values": [0.0, 0.1, 0.2],
      "method": "add_random_edges",
      "oracle_mode": "non_oracle",
      "oracle_labels": false,
      "graph_view_mode": "heterograph_aware_generation",
      "relation_filter": ["net_rsr", "net_rtr", "net_rur"],
      "relation_allocation": "proportional",
      "undirected": false,
      "allow_self_loops": false,
      "reject_existing": true,
      "reject_duplicates": true,
      "max_attempt_multiplier": 20
    }
  ],
  "seeds": {
    "graph_seeds": [0],
    "training_seeds": [0, 1, 2, 3, 4],
    "policy": "Prioritize split-level replication and five optimization repeats while keeping the three-split graph cache within the measured Kaggle disk budget."
  },
  "evaluation": {
    "metrics": ["roc_auc", "average_precision", "f1_macro"],
    "threshold_selection": "best_f1_on_validation",
    "no_test_leakage": true,
    "no_test_leakage_scope": "Model fitting, early stopping, hyperparameter selection, and threshold selection do not read test outcomes; controlled oracle perturbation construction is the explicitly disclosed exception.",
    "oracle_perturbation_label_scope": "all_nodes_including_test",
    "reporting": ["mean", "std", "seed_aware_hierarchical_bootstrap_ci"],
    "export_variant_audit": true,
    "audit_metrics": [
      "n_rewired_edges_actual",
      "heterophily_ratio_before",
      "heterophily_ratio_after",
      "mean_cosine_to_sampled_normal_before",
      "mean_cosine_to_sampled_normal_after",
      "fraud_to_normal_neighbor_ratio_before",
      "fraud_to_normal_neighbor_ratio_after",
      "n_added_edge_pairs_actual"
    ]
  },
  "disclosures": [
    "Oracle train-on-variant rows expose label-constructed graph structure during training and are privileged-label diagnostics, not deployment robustness estimates.",
    "All model adapters evaluate the shared homogeneous graph; PMP and SEC-GFD results must be described as benchmark-adapter results.",
    "The single graph seed is a deliberate storage trade-off; uncertainty across perturbation realizations remains a limitation.",
    "This benchmark is a static controlled stress evaluation, not a realistic adversarial fraud simulation."
  ]
}
