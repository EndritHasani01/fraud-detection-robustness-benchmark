{
  "created_date": "2026-02-13",
  "data_splits": [
    {
      "policy": "Single fixed split reused across all scenarios and severities.",
      "split_id": "s0",
      "split_seed": 717,
      "train_size": 0.4,
      "val_size": 0.2
    }
  ],
  "datasets": [
    {
      "dataset_id": "yelpchi",
      "notes": "YelpChi as exposed by DGL FraudDataset.",
      "source": "dgl.data.FraudDataset",
      "source_name": "yelp"
    }
  ],
  "disclosures": [
    "Oracle perturbations: some scenarios use true labels to construct stress tests. This must be disclosed in the report.",
    "Canonical graph view is homogeneous (relations merged) for cross-model comparability."
  ],
  "evaluation": {
    "metrics": [
      "roc_auc",
      "average_precision",
      "f1_macro"
    ],
    "no_test_leakage": true,
    "reporting": [
      "mean",
      "std"
    ],
    "threshold_selection": "best_f1_on_validation"
  },
  "experiment_name": "gfd_robustness_benchmark_v1",
  "graph_representation": {
    "canonical_view": "homogeneous",
    "conversion": "dgl.to_homogeneous",
    "from_source_view": "heterograph",
    "rationale": "Keeps one canonical graph view for all models and perturbations; relation types are merged."
  },
  "models": [
    {
      "category": "baseline",
      "input": "node_features_only",
      "model_id": "mlp",
      "notes": "Required sanity baseline (no message passing).",
      "type": "mlp"
    },
    {
      "category": "baseline",
      "input": "graph_plus_node_features",
      "model_id": "sage",
      "notes": "One standard message-passing baseline.",
      "type": "graphsage"
    },
    {
      "category": "specialized",
      "model_id": "pmp",
      "notes": "Specialized method from paper: Partitioning Message Passing (ICLR 2024).",
      "repo_path": "Repos/PMP-master",
      "type": "pmp"
    },
    {
      "category": "specialized",
      "model_id": "secgfd",
      "notes": "Specialized method from paper: SEC-GFD (AAAI 2024).",
      "repo_path": "Repos/SEC-GFD-main",
      "type": "sec_gfd"
    }
  ],
  "project_topic": "Fraud detection using graphs (node-level anomaly/fraud classification)",
  "scenarios": [
    {
      "family": "heterophily",
      "method": "rewire_edge_dst_to_opposite_label",
      "notes": "Uses ground-truth labels to enforce opposite-label neighbors (oracle stress test).",
      "oracle_labels": true,
      "scenario_id": "heterophily_rewire_oracle",
      "severity_param": "p_rewire",
      "severity_values": [
        0.0,
        0.1,
        0.2,
        0.3
      ]
    },
    {
      "family": "camouflage",
      "gamma": 1.0,
      "method": "replace_fraud_features_with_normal_features",
      "notes": "Feature camouflage by replacing a fraction of fraud node features with randomly sampled normal features.",
      "oracle_labels": true,
      "scenario_id": "camouflage_feature_oracle",
      "severity_param": "p_cam_feat",
      "severity_values": [
        0.0,
        0.1,
        0.2,
        0.3
      ]
    },
    {
      "family": "noise",
      "method": "add_random_edges",
      "notes": "Adds random directed edges; logs density/degree shift.",
      "scenario_id": "noise_edges",
      "severity_param": "edge_noise_rate",
      "severity_values": [
        0.0,
        0.05,
        0.1,
        0.2
      ],
      "undirected": false
    }
  ],
  "seeds": {
    "policy": "Metrics are aggregated across training seeds; split is fixed unless additional splits are added.",
    "training_seeds": [
      0,
      1,
      2,
      3,
      4
    ]
  }
}
